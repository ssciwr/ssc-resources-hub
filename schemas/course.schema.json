{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SSC public course specification",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Z][0-9]{2}(-[CO])?$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "outcome": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "coverage": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "courseType": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "external": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "prerequisiteRationale": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "mapName": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "practice": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "acceptance": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "learn": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1
    },
    "prior": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1
    },
    "moduleDescriptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "instructors": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "uniqueItems": true
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "mvp": {
      "type": "integer",
      "enum": [
        0,
        1
      ]
    },
    "duration_minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 240
    }
  },
  "required": [
    "courseType",
    "coverage",
    "description",
    "duration_minutes",
    "external",
    "goal",
    "id",
    "instructors",
    "learn",
    "moduleDescriptions",
    "modules",
    "mvp",
    "name",
    "outcome",
    "prerequisiteRationale",
    "prior",
    "references",
    "roles",
    "tools"
  ],
  "additionalProperties": false,
  "dependentRequired": {
    "practice": [
      "acceptance"
    ],
    "acceptance": [
      "practice"
    ]
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SSC public roadmap registries and layout",
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "course-id": {
      "type": "string",
      "pattern": "^[A-Z][0-9]{2}(-[CO])?$"
    },
    "https-url": {
      "type": "string",
      "pattern": "^https://[^\\s]+$"
    },
    "roadmap": {
      "type": "object",
      "properties": {
        "version": {
          "$ref": "#/$defs/text"
        },
        "baseline": {
          "$ref": "#/$defs/text"
        },
        "equivalent_course_groups": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/course-id"
            },
            "minItems": 2,
            "uniqueItems": true
          }
        },
        "course_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/course-id"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "version",
        "baseline",
        "equivalent_course_groups",
        "course_ids"
      ],
      "additionalProperties": false
    },
    "learning-goals": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(F|LG-[0-9]{2})$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/text"
      }
    },
    "audiences": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "label": {
            "$ref": "#/$defs/text"
          },
          "help": {
            "$ref": "#/$defs/text"
          }
        },
        "required": [
          "label",
          "help"
        ],
        "additionalProperties": false
      }
    },
    "bibliography": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "citation": {
            "$ref": "#/$defs/text"
          },
          "url": {
            "anyOf": [
              {
                "$ref": "#/$defs/https-url"
              },
              {
                "const": ""
              }
            ]
          }
        },
        "required": [
          "citation",
          "url"
        ],
        "additionalProperties": false
      }
    },
    "instructors": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "#/$defs/text"
          },
          "initials": {
            "$ref": "#/$defs/text"
          },
          "position": {
            "$ref": "#/$defs/text"
          },
          "affiliation": {
            "$ref": "#/$defs/text"
          },
          "github": {
            "type": "string",
            "pattern": "^https://github\\.com/[A-Za-z0-9][A-Za-z0-9-]*/?$"
          },
          "githubHandle": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*$"
          },
          "avatar": {
            "$ref": "#/$defs/https-url"
          },
          "source": {
            "$ref": "#/$defs/https-url"
          }
        },
        "required": [
          "name",
          "initials",
          "affiliation"
        ],
        "additionalProperties": false
      }
    },
    "dependencies": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z][0-9]{2}(-[CO])?$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "all_of": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/course-id"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "any_of": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/course-id"
              },
              "minItems": 2,
              "uniqueItems": true
            },
            "minItems": 0,
            "maxItems": 1
          },
          "recommended": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/course-id"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "conditional": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "course": {
                  "$ref": "#/$defs/course-id"
                },
                "when": {
                  "$ref": "#/$defs/text"
                }
              },
              "required": [
                "course",
                "when"
              ],
              "additionalProperties": false
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "all_of",
          "any_of",
          "recommended",
          "conditional"
        ],
        "additionalProperties": false
      }
    },
    "svg-attributes": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "aria-label",
          "class",
          "cx",
          "cy",
          "d",
          "data-a",
          "data-b",
          "data-gate",
          "data-goal",
          "data-id",
          "fill",
          "height",
          "id",
          "marker-end",
          "markerHeight",
          "markerUnits",
          "markerWidth",
          "orient",
          "points",
          "r",
          "refX",
          "refY",
          "role",
          "rx",
          "stroke",
          "stroke-dasharray",
          "stroke-linecap",
          "stroke-linejoin",
          "stroke-width",
          "tabindex",
          "text-anchor",
          "width",
          "x",
          "y"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/text"
      },
      "properties": {
        "fill": {
          "$ref": "#/$defs/svg-colour"
        },
        "stroke": {
          "$ref": "#/$defs/svg-colour"
        },
        "marker-end": {
          "$ref": "#/$defs/svg-marker"
        }
      }
    },
    "element": {
      "type": "object",
      "properties": {
        "tag": {
          "enum": [
            "defs",
            "g",
            "rect",
            "text",
            "polyline",
            "circle",
            "marker",
            "path",
            "title"
          ]
        },
        "attrs": {
          "$ref": "#/$defs/svg-attributes"
        },
        "text": {
          "type": "string"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element"
          },
          "minItems": 0
        },
        "course_id": {
          "$ref": "#/$defs/course-id"
        },
        "baseline_title": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "tag",
        "attrs"
      ],
      "additionalProperties": false
    },
    "layout": {
      "type": "object",
      "properties": {
        "svg": {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/text"
            },
            "viewBox": {
              "$ref": "#/$defs/text"
            },
            "width": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "height": {
              "type": "string",
              "pattern": "^[1-9][0-9]*$"
            },
            "class": {
              "$ref": "#/$defs/text"
            },
            "role": {
              "$ref": "#/$defs/text"
            },
            "aria-label": {
              "$ref": "#/$defs/text"
            }
          },
          "required": [
            "id",
            "viewBox",
            "width",
            "height",
            "class",
            "role",
            "aria-label"
          ],
          "additionalProperties": false
        },
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/element"
          },
          "minItems": 1
        }
      },
      "required": [
        "svg",
        "elements"
      ],
      "additionalProperties": false
    },
    "svg-colour": {
      "type": "string",
      "pattern": "^(?:[a-zA-Z]+|#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8}))$"
    },
    "svg-marker": {
      "type": "string",
      "pattern": "^(?:none|url\\(#[a-zA-Z][a-zA-Z0-9_.:-]*\\))$"
    }
  }
}
